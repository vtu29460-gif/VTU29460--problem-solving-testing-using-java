import java.util.*;

public class Solution {
    static int longestPalindrome(String s) {
        int n = s.length();
        int[] odd = new int[n];
        int[] even = new int[n];
        int ans = 0, l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 :
                Math.min(odd[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < n &&
                   s.charAt(i - k) == s.charAt(i + k))
                k++;

            odd[i] = k;
            ans = Math.max(ans, 2 * k - 1);

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        l = 0;
        r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 0 :
                Math.min(even[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 && i + k < n &&
                   s.charAt(i - k - 1) == s.charAt(i + k))
                k++;

            even[i] = k;
            ans = Math.max(ans, 2 * k);

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        return ans;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        String s = sc.next();

        for (int i = 0; i < n; i++) {
            String rotation = s.substring(i) + s.substring(0, i);
            System.out.println(longestPalindrome(rotation));
        }
    }
}
