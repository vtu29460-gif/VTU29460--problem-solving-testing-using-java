class Solution {
    public void moveZeroes(int[] arr) {
        
      int n = arr.length;

      for(int i=0; i<n-1;i++){
        for(int j=i+1; j<n; j++){
           if( arr[i] == 0 && arr[j]>arr[i]){
            swap(arr,i,j);
            i++;
            j--;
           }else if(arr[i] ==0 && arr[j] < 0){
              swap(arr,i,j);
              i++;
              j--;
           }
           else if(arr[j] == 0) {
             continue;
           }
        }
      }
    
    }
      static void swap(int [] arr , int first, int second){
           int temp = arr[first];
           arr[first] = arr[second];
           arr[second] = temp;
        }
}
