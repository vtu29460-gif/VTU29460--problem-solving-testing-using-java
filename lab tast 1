import java.util.*;
import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] salary = new int[n];

        for (int i = 0; i < n; i++) {
            salary[i] = sc.nextInt();
        }

        Arrays.stream(salary)
              .map(s -> s - (s / 10)) // deduct 10%
              .forEach(s -> System.out.print(s + " "));

        sc.close();
    }
}
